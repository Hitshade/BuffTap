# Keep only reviewed development files at the repository root.
/*
!/.gitignore
!/README.md
!/DEVELOPMENT.md
!/RELEASE-NOTES-*.md
!/requirements-dev.txt
!/addon/
!/tests/
!/tools/
!/docs/
/docs/*
!/docs/GITHUB-BASELINE.md
!/docs/CATALOG-DATA.md
!/docs/RELEASE-REVIEW-1.1.0.md
!/docs/RELEASE-REVIEW-1.1.1.md
__pycache__/
*.pyc
*.zip
.env*
tests/last-run.txt

tests/last-run-*.txt
